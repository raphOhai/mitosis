    {
      "id": "c7d23698-efd1-555b-9a87-af56df042ba8",
      "name": "Summarize Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const base = String($env.MITOSIS_URL || '').replace(/\\/+$/, '');\nconst money = (value) => `$${Number(value || 0).toFixed(2)}`;\nconst launchable = (result) => result.review !== 'rejected' && (result.status === 'passed' || result.review === 'approved');\n\nconst relativePath = (path, outDir, runId) => {\n  const value = String(path || '');\n  const root = String(outDir || '').replace(/\\/+$/, '');\n  if (root && value.startsWith(`${root}/`)) {\n    return value.slice(root.length + 1);\n  }\n  const marker = `/${runId}/`;\n  const index = value.lastIndexOf(marker);\n  return index >= 0 ? value.slice(index + marker.length) : value.replace(/^\\/+/, '');\n};\n\nconst fileUrl = (runId, relative) =>\n  `${base}/files/${encodeURIComponent(runId)}/${relative.split('/').map(encodeURIComponent).join('/')}`;\n\nreturn $input.all().map(({ json: manifest }) => {\n  const runId = manifest.run_id;\n  const winnerId = (manifest.winner || {}).id || 'winner';\n  const totals = manifest.totals || {};\n  const results = manifest.results || [];\n  const ready = results.filter(launchable);\n  const uploads = ready.flatMap((result) =>\n    (result.renders || []).map((render) => ({\n      run_id: runId,\n      variant_id: result.spec.id,\n      aspect: render.aspect,\n      ad_name: render.name,\n      file_url: fileUrl(runId, relativePath(render.path, manifest.out_dir, runId)),\n    })),\n  );\n  const variants = totals.variants || results.length;\n  const passed = totals.passed || 0;\n  const passRate = variants ? Math.round((100 * passed) / variants) : 0;\n  const reportUrl = fileUrl(runId, 'report.html');\n  const lines = [\n    `*Mitosis multiplied ${winnerId}* (run \\`${runId}\\`, ${manifest.mode || 'unknown'} mode)`,\n    `Variants: ${variants} | passed ${passed} | flagged ${totals.flagged || 0} | failed ${totals.failed || 0} | pass rate ${passRate}%`,\n    `Spend: ${money(totals.usd)} actual | ${money(totals.shadow_usd)} production-equivalent | ${money(totals.shadow_per_variant)} per variant at production prices`,\n    `Time: ${(Number(totals.seconds || 0) / 60).toFixed(1)} min wall | ${Number(totals.seconds_per_variant || 0).toFixed(0)} s per variant | cache hits ${totals.cache_hits || 0}, saved ${money(totals.saved_usd)}`,\n    `Ready to launch: ${ready.length} variants, ${uploads.length} ads`,\n    `<${reportUrl}|Open the run report>`,\n  ];\n\n  return {\n    json: {\n      run_id: runId,\n      winner_id: winnerId,\n      report_url: reportUrl,\n      variants,\n      passed,\n      flagged: totals.flagged || 0,\n      failed: totals.failed || 0,\n      usd: totals.usd || 0,\n      shadow_usd: totals.shadow_usd || 0,\n      uploads,\n      slack_text: lines.join('\\n'),\n    },\n  };\n});\n"
      }
    },
