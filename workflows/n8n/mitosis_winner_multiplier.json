    {
      "id": "241b8f04-b756-5578-b0e9-7b24fab3c0f5",
      "name": "Build Run Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const winner = $('Describe Winner').item.json;\nconst video = $('Download Winner').item.binary.video;\nconst script = String($json.script || winner.description || '').trim();\n\nif (!video) {\n  throw new Error(`Could not download ${winner.file_name} from Google Drive`);\n}\nif (!script) {\n  const companion = winner.file_name.replace(/\\.[^.]+$/, '') + '.txt';\n  throw new Error(`No script for ${winner.file_name}: add ${companion} to the Winners folder or fill the file description`);\n}\n\nreturn {\n  json: { winner_id: winner.winner_id, file_name: winner.file_name, script },\n  binary: { video },\n};\n"
      },
      "onError": "continueErrorOutput"
    },
