    {
      "id": "0b2b4b4e-d6a8-5827-a23f-6823108e2612",
      "name": "Describe Winner",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const file = $json;\nconst baseName = String(file.name || file.id).replace(/\\.[^.]+$/, '');\nconst folderId = (file.parents || [])[0] || '';\nconst quoteForDrive = (value) => String(value).replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\");\nconst winnerId = baseName.replace(/[^A-Za-z0-9-]+/g, '-').replace(/^-+|-+$/g, '') || file.id;\n\nreturn {\n  json: {\n    file_id: file.id,\n    file_name: file.name,\n    folder_id: folderId,\n    winner_id: winnerId,\n    description: String(file.description || '').trim(),\n    script_query: `'${quoteForDrive(folderId)}' in parents and name = '${quoteForDrive(baseName)}.txt' and trashed = false`,\n  },\n};\n"
      }
    },
